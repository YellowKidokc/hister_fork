# Copy to .env and keep it private. Do not commit real credentials.
# Generate distinct tokens/passwords (for example: openssl rand -hex 32).
TP_DB_PASSWORD=
TP_ACCESS_TOKEN=
TP_HISTER_TOKEN=

# Set only after inspecting the NAS. No /volume1 or SSD layout is assumed.
TP_POSTGRES_DIR=
TP_HISTER_DIR=
TP_DOCUMENT_DIR=

# Loopback by default; use Synology's HTTPS reverse proxy on this same host.
TP_BIND_ADDRESS=127.0.0.1
TP_HISTER_IMAGE=theophysics-hister:local

# Exact public hosts only, comma separated. Include redirect destinations.
TP_URL_HOSTS=
# Optional OpenAI-compatible service. Excerpts are sent only on Suggest with AI.
TP_AI_BASE_URL=
TP_AI_MODEL=
TP_AI_KEY=

# Display-only destination for Storage move previews. No folder is created and
# no file transfer is enabled by this setting. PostgreSQL/Hister stay on NVMe.
TP_VOLUME_ONE_FOLDER=/volume1/Theophysics/library
